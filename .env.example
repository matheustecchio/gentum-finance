# Compose configuration. Copy to .env only when overriding defaults.
GENTUM_PORT=5173
GENTUM_DATABASE_NAME=gentum_finance
GENTUM_DATABASE_USERNAME=gentum
GENTUM_DATABASE_PASSWORD=gentum_dev_only
GENTUM_DATABASE_VOLUME=gentum-finance_gentum-postgres-data
# Host development only; Docker uses the discrete database variables above.
GENTUM_DATABASE_URL=postgres://gentum:gentum_dev_only@localhost:5432/gentum_finance?sslmode=disable
GENTUM_SERVER_ADDRESS=127.0.0.1
GENTUM_FRONTEND_ORIGIN=http://localhost:5173
