{
  "name": "gentum-finance-frontend",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "test": "vitest run && node --test scripts/version.test.mjs",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage && node --test scripts/version.test.mjs",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit -p tsconfig.app.json --pretty false && tsc --noEmit -p tsconfig.node.json --pretty false",
    "desktop:prepare": "python3 ../scripts/prepare-desktop.py",
    "desktop:build": "npm run desktop:prepare && cd ../desktop && tauri build",
    "desktop:dev": "npm run desktop:prepare && cd ../desktop && tauri dev"
  },
  "dependencies": {
    "@apollo/client": "3.13.2",
    "@hookform/resolvers": "3.10.0",
    "@tauri-apps/api": "2.12.4",
    "graphql": "16.10.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-hook-form": "7.54.2",
    "react-router-dom": "7.18.3",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tauri-apps/cli": "2.12.4",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.2.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "20.17.24",
    "@types/react": "19.0.10",
    "@types/react-dom": "19.0.4",
    "@vitejs/plugin-react": "4.3.4",
    "@vitest/coverage-v8": "3.2.7",
    "jsdom": "26.0.0",
    "typescript": "5.7.3",
    "vite": "6.4.3",
    "vitest": "3.2.7"
  }
}
